{
  "name": "stash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "build": "pnpm --dir ../app install --frozen-lockfile && pnpm --dir ../app build",
    "start": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "check": "tsc && node src/index.check.mjs"
  },
  "dependencies": {
    "itty-router": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
